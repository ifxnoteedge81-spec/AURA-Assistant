# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional (Recommended for 24/7 Render Background Sync):
# Paste your Firebase Service Account JSON (single-line or base64) so the Render Node server
# reads/writes chat memories, 64-district dictionary, notes, and WhatsApp session backups directly to Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Dashboard Security Lock (Protects public dashboard URL on Render):
OWNER_EMAIL="ifxnoteedge81@gmail.com"
# Optional 4-8 digit 2FA PIN (can also be set inside the Security & Anti-Ban tab)
DASHBOARD_PIN=""
# Optional persistent HMAC secret for dashboard sessions across server restarts
DASHBOARD_AUTH_SECRET=""
