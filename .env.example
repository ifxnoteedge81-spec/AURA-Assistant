OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional (Recommended for 24/7 Render Background Sync):
# Paste your Firebase Service Account JSON (single-line or base64) so the Render Node server
