{
  "entities": {
    "BotSettings": {
      "title": "BotSettings",
      "description": "Global configuration, owner persona bio, boundaries, tone, and anti-link group rules for the WhatsApp AI Executive Assistant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the bot owner."
        },
        "autoreply": {
          "type": "boolean",
          "description": "Whether automated private inbox assistant is active."
        },
        "aiAssistantEnabled": {
          "type": "boolean",
          "description": "Whether Gemini AI dynamic replies are active instead of static fallback."
        },
        "autoreplyMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Default or fallback Bengali auto-reply text."
        },
        "firstGreetingTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "description": "Guidance for the first greeting when Sir is unavailable."
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120,
          "description": "Owner display name referenced by the AI assistant."
        },
        "ownerProfession": {
          "type": "string",
          "maxLength": 200,
          "description": "Owner profession or role."
        },
        "ownerLocation": {
          "type": "string",
          "maxLength": 200,
          "description": "Owner city or district."
        },
        "ownerBio": {
          "type": "string",
          "maxLength": 4000,
          "description": "Positive biographical context about Sir for the AI to share when asked."
        },
        "ownerBoundaries": {
          "type": "string",
          "maxLength": 4000,
          "description": "Explicit tasks or topics Sir does not handle (e.g., flat rentals, loans)."
        },
        "strictLogicRules": {
          "type": "string",
          "maxLength": 4000,
          "description": "Strict reasoning, debate, emotion matching, full inbox continuity, and time-lapse rules."
        },
        "assistantTone": {
          "type": "string",
          "enum": ["witty_flirty", "warm_polite", "executive_formal", "sharp_shut_down"],
          "description": "Active conversational personality mode."
        },
        "cooldownMs": {
          "type": "number",
          "description": "Per-sender reply cooldown in milliseconds."
        },
        "takeoverPauseMs": {
          "type": "number",
          "description": "Auto-pause duration in milliseconds after owner manually replies in a chat."
        },
        "humanTypingEnabled": {
          "type": "boolean",
          "description": "Enables natural read receipts, reading delay, typing speed simulation, and anti-ban queue."
        },
        "dailyReplyLimit": {
          "type": "number",
          "description": "Maximum automated replies allowed per 24 hours as an anti-ban safeguard."
        },
        "antilinkGroups": {
          "type": "object",
          "description": "Map of WhatsApp group JIDs to boolean anti-link enforcement state."
        },
        "groupAiEnabled": {
          "type": "boolean",
          "description": "Master switch for Smart Group AI Clone participation."
        },
        "groupAiMode": {
          "type": "string",
          "enum": ["smart_blend", "mention_only", "active_chat"],
          "description": "Group AI participation behavior mode."
        },
        "groupReactionEnabled": {
          "type": "boolean",
          "description": "Allows AI clone to send emoji reactions to group messages."
        },
        "groupCooldownMs": {
          "type": "number",
          "description": "Minimum cooldown in milliseconds between AI text replies in the same group."
        },
        "groupAiGroups": {
          "type": "object",
          "description": "Map of WhatsApp group JIDs to boolean Group AI Clone enabled state."
        },
        "groupDirectives": {
          "type": "object",
          "description": "Map of WhatsApp group JIDs to per-group AI command prompts and member mention target objectives."
        },
        "configUpdatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Monotonic ISO timestamp tracking latest settings modification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "autoreply",
        "aiAssistantEnabled",
        "autoreplyMessage",
        "assistantTone",
        "cooldownMs",
        "takeoverPauseMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "DictionaryEntry": {
      "title": "DictionaryEntry",
      "description": "Bangla 64-district dialect or Bangla-English phrase entry used by the AI assistant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "language": {
          "type": "string",
          "enum": ["bn_dialect", "bn_en", "en_slang"]
        },
        "replyStyleHint": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "term",
        "meaning",
        "district",
        "language",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMemory": {
      "title": "ChatMemory",
      "description": "Per-contact conversation memory window for context-aware private assistant replies.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactJid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contactName": {
          "type": "string",
          "maxLength": 120
        },
        "detectedDistrict": {
          "type": "string",
          "maxLength": 100
        },
        "lastSummary": {
          "type": "string",
          "maxLength": 1000
        },
        "turns": {
          "type": "array",
          "description": "Bounded recent conversation turns (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "contactJid",
        "turns",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatArchiveMessage": {
      "title": "ChatArchiveMessage",
      "description": "Immutable archived message turn under a contact memory document for unlimited long-term recall.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "chatId",
        "role",
        "text",
        "timestamp",
        "createdAt"
      ]
    },
    "InboxNote": {
      "title": "InboxNote",
      "description": "Important message or follow-up note left for Sir by a contact while Sir was unavailable.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactJid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contactName": {
          "type": "string",
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "urgency": {
          "type": "string",
          "enum": ["normal", "important"]
        },
        "resolved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "contactJid",
        "summary",
        "urgency",
        "resolved",
        "createdAt",
        "updatedAt"
      ]
    },
    "BotSessionBackup": {
      "title": "BotSessionBackup",
      "description": "Baileys MultiFileAuthState credentials backup for surviving ephemeral Render restarts.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 32
        },
        "credsData": {
          "type": "object",
          "description": "Parsed Baileys creds.json map."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "credsData",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientBot": {
      "title": "ClientBot",
      "description": "Independent Zero-AI client WhatsApp bot instance with active kill-switch, per-group custom moderation, and saved auto-reply SMS rules.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "botId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 32
        },
        "active": {
          "type": "boolean"
        },
        "clientAccessKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "moderateAllGroups": {
          "type": "boolean"
        },
        "defaultModeration": {
          "type": "object"
        },
        "groupRules": {
          "type": "object"
        },
        "savedReplyEnabled": {
          "type": "boolean"
        },
        "savedReplyMessage": {
          "type": "string",
          "maxLength": 2000
        },
        "savedReplyCooldownMs": {
          "type": "number"
        },
        "keywordReplies": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "botId",
        "clientName",
        "active",
        "clientAccessKey",
        "moderateAllGroups",
        "defaultModeration",
        "groupRules",
        "savedReplyEnabled",
        "savedReplyMessage",
        "savedReplyCooldownMs",
        "keywordReplies",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/bot_settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/BotSettings"
      },
      "description": "Stores bot configuration, owner persona bio, tone, boundaries, and group anti-link map."
    },
    "/dictionary_entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/DictionaryEntry"
      },
      "description": "Stores 64-district Bangla dialect and Bangla-English dictionary entries."
    },
    "/chat_memories/{chatId}": {
      "schema": {
        "$ref": "#/entities/ChatMemory"
      },
      "description": "Stores bounded conversation history per private WhatsApp contact."
    },
    "/chat_memories/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatArchiveMessage"
      },
      "description": "Stores unlimited archived conversation turns per contact for long-term AI recall."
    },
    "/inbox_notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/InboxNote"
      },
      "description": "Stores important messages left for Sir."
    },
    "/bot_sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/BotSessionBackup"
      },
      "description": "Stores Baileys credentials backup."
    },
    "/client_bots/{botId}": {
      "schema": {
        "$ref": "#/entities/ClientBot"
      },
      "description": "Stores Zero-AI multi-number client bot configurations, active kill-switches, and per-group moderation rules."
    }
  }
}
