rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // Hardened Global Helpers
    // ------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ifxnoteedge81@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwnerResource() {
      return isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------------------
    // Entity Validation Blueprints
    // ------------------------------------------------------------------------
    function isValidBotSettings(data) {
      return data.keys().hasAll([
          'ownerId', 'autoreply', 'aiAssistantEnabled', 'autoreplyMessage',
          'assistantTone', 'cooldownMs', 'takeoverPauseMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'autoreply', 'aiAssistantEnabled', 'autoreplyMessage',
          'firstGreetingTemplate', 'ownerName', 'ownerProfession', 'ownerLocation',
          'ownerBio', 'ownerBoundaries', 'strictLogicRules', 'assistantTone', 'cooldownMs',
          'takeoverPauseMs', 'humanTypingEnabled', 'dailyReplyLimit',
          'antilinkGroups', 'groupAiEnabled', 'groupAiMode', 'groupReactionEnabled',
          'groupCooldownMs', 'groupAiGroups', 'groupDirectives', 'mediaIntelligenceEnabled',
          'mediaZeroTokenReplyMode', 'storyAutoReadEnabled', 'storyAutoReactEnabled',
          'storyAutoReplyEnabled', 'storyCooldownMs', 'storyWhitelistMode',
          'storyAllowedContacts', 'selfChatCopilotEnabled', 'selfChatZeroTokenOnly',
          'contactPolicies', 'configUpdatedAt',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.autoreply is bool
        && data.aiAssistantEnabled is bool
        && data.autoreplyMessage is string && data.autoreplyMessage.size() >= 1 && data.autoreplyMessage.size() <= 2000
        && (!('firstGreetingTemplate' in data) || (data.firstGreetingTemplate is string && data.firstGreetingTemplate.size() <= 1500))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120))
        && (!('ownerProfession' in data) || (data.ownerProfession is string && data.ownerProfession.size() <= 200))
        && (!('ownerLocation' in data) || (data.ownerLocation is string && data.ownerLocation.size() <= 200))
        && (!('ownerBio' in data) || (data.ownerBio is string && data.ownerBio.size() <= 4000))
        && (!('ownerBoundaries' in data) || (data.ownerBoundaries is string && data.ownerBoundaries.size() <= 4000))
        && (!('strictLogicRules' in data) || (data.strictLogicRules is string && data.strictLogicRules.size() <= 4000))
        && data.assistantTone in ['witty_flirty', 'warm_polite', 'executive_formal', 'sharp_shut_down']
        && data.cooldownMs is number && data.cooldownMs >= 0 && data.cooldownMs <= 86400000
        && data.takeoverPauseMs is number && data.takeoverPauseMs >= 0 && data.takeoverPauseMs <= 86400000
        && (!('humanTypingEnabled' in data) || data.humanTypingEnabled is bool)
        && (!('dailyReplyLimit' in data) || (data.dailyReplyLimit is number && data.dailyReplyLimit >= 1 && data.dailyReplyLimit <= 2000))
        && (!('antilinkGroups' in data) || (data.antilinkGroups is map && data.antilinkGroups.size() <= 200))
        && (!('groupAiEnabled' in data) || data.groupAiEnabled is bool)
        && (!('groupAiMode' in data) || (data.groupAiMode in ['smart_blend', 'mention_only', 'active_chat']))
        && (!('groupReactionEnabled' in data) || data.groupReactionEnabled is bool)
        && (!('groupCooldownMs' in data) || (data.groupCooldownMs is number && data.groupCooldownMs >= 0 && data.groupCooldownMs <= 3600000))
        && (!('groupAiGroups' in data) || (data.groupAiGroups is map && data.groupAiGroups.size() <= 200))
        && (!('groupDirectives' in data) || (data.groupDirectives is map && data.groupDirectives.size() <= 200))
        && (!('mediaIntelligenceEnabled' in data) || data.mediaIntelligenceEnabled is bool)
        && (!('mediaZeroTokenReplyMode' in data) || data.mediaZeroTokenReplyMode is bool)
        && (!('storyAutoReadEnabled' in data) || data.storyAutoReadEnabled is bool)
        && (!('storyAutoReactEnabled' in data) || data.storyAutoReactEnabled is bool)
        && (!('storyAutoReplyEnabled' in data) || data.storyAutoReplyEnabled is bool)
        && (!('storyCooldownMs' in data) || (data.storyCooldownMs is number && data.storyCooldownMs >= 0 && data.storyCooldownMs <= 86400000))
        && (!('storyWhitelistMode' in data) || (data.storyWhitelistMode in ['all', 'selected_only']))
        && (!('storyAllowedContacts' in data) || (data.storyAllowedContacts is list && data.storyAllowedContacts.size() <= 200 && (data.storyAllowedContacts.size() == 0 || data.storyAllowedContacts[0] is map)))
        && (!('selfChatCopilotEnabled' in data) || data.selfChatCopilotEnabled is bool)
        && (!('selfChatZeroTokenOnly' in data) || data.selfChatZeroTokenOnly is bool)
        && (!('contactPolicies' in data) || (data.contactPolicies is list && data.contactPolicies.size() <= 200 && (data.contactPolicies.size() == 0 || data.contactPolicies[0] is map)))
        && (!('configUpdatedAt' in data) || (data.configUpdatedAt is string && data.configUpdatedAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDictionaryEntry(data) {
      return data.keys().hasAll(['ownerId', 'term', 'meaning', 'district', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'term', 'meaning', 'district', 'language', 'replyStyleHint', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.term is string && data.term.size() >= 1 && data.term.size() <= 200
        && data.meaning is string && data.meaning.size() >= 1 && data.meaning.size() <= 500
        && data.district is string && data.district.size() >= 1 && data.district.size() <= 100
        && data.language in ['bn_dialect', 'bn_en', 'en_slang']
        && (!('replyStyleHint' in data) || (data.replyStyleHint is string && data.replyStyleHint.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMemory(data) {
      return data.keys().hasAll(['ownerId', 'contactJid', 'turns', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'contactJid', 'contactName', 'detectedDistrict', 'lastSummary', 'turns', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.contactJid is string && data.contactJid.size() >= 1 && data.contactJid.size() <= 128
        && (!('contactName' in data) || (data.contactName is string && data.contactName.size() <= 120))
        && (!('detectedDistrict' in data) || (data.detectedDistrict is string && data.detectedDistrict.size() <= 100))
        && (!('lastSummary' in data) || (data.lastSummary is string && data.lastSummary.size() <= 1000))
        && data.turns is list && data.turns.size() <= 20
        && (data.turns.size() == 0 || data.turns[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatArchiveMessage(data) {
      return data.keys().hasAll(['ownerId', 'chatId', 'role', 'text', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'chatId', 'role', 'text', 'timestamp', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.chatId is string && isValidId(data.chatId)
        && data.role in ['user', 'assistant']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidInboxNote(data) {
      return data.keys().hasAll(['ownerId', 'contactJid', 'summary', 'urgency', 'resolved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'contactJid', 'contactName', 'summary', 'urgency', 'resolved', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.contactJid is string && data.contactJid.size() >= 1 && data.contactJid.size() <= 128
        && (!('contactName' in data) || (data.contactName is string && data.contactName.size() <= 120))
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1000
        && data.urgency in ['normal', 'important']
        && data.resolved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBotSession(data) {
      return data.keys().hasAll(['ownerId', 'credsData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'phoneNumber', 'credsData', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.credsData is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientBot(data) {
      return data.keys().hasAll([
          'ownerId', 'botId', 'clientName', 'active', 'clientAccessKey',
          'moderateAllGroups', 'defaultModeration', 'groupRules',
          'savedReplyEnabled', 'savedReplyMessage', 'savedReplyCooldownMs',
          'keywordReplies', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'botId', 'clientName', 'phoneNumber', 'active', 'clientAccessKey',
          'moderateAllGroups', 'defaultModeration', 'groupRules',
          'savedReplyEnabled', 'savedReplyMessage', 'savedReplyCooldownMs',
          'keywordReplies', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.botId is string && isValidId(data.botId)
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.active is bool
        && data.clientAccessKey is string && data.clientAccessKey.size() >= 16 && data.clientAccessKey.size() <= 128
        && data.moderateAllGroups is bool
        && data.defaultModeration is map && data.defaultModeration.size() <= 20
        && data.groupRules is map && data.groupRules.size() <= 200
        && data.savedReplyEnabled is bool
        && data.savedReplyMessage is string && data.savedReplyMessage.size() <= 2000
        && data.savedReplyCooldownMs is number && data.savedReplyCooldownMs >= 0 && data.savedReplyCooldownMs <= 86400000
        && data.keywordReplies is list && data.keywordReplies.size() <= 50
        && (data.keywordReplies.size() == 0 || data.keywordReplies[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /bot_settings/{settingId} {
      allow get: if isValidId(settingId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidBotSettings(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidBotSettings(incoming())
        && isOwnerResource()
        && (incoming().ownerId == existing().ownerId || (existing().ownerId == 'server_admin' && isAdmin()))
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerId', 'autoreply', 'aiAssistantEnabled', 'autoreplyMessage',
          'firstGreetingTemplate', 'ownerName', 'ownerProfession',
          'ownerLocation', 'ownerBio', 'ownerBoundaries', 'strictLogicRules', 'assistantTone',
          'cooldownMs', 'takeoverPauseMs', 'humanTypingEnabled', 'dailyReplyLimit',
          'antilinkGroups', 'groupAiEnabled', 'groupAiMode', 'groupReactionEnabled',
          'groupCooldownMs', 'groupAiGroups', 'groupDirectives', 'mediaIntelligenceEnabled',
          'mediaZeroTokenReplyMode', 'storyAutoReadEnabled', 'storyAutoReactEnabled',
          'storyAutoReplyEnabled', 'storyCooldownMs', 'storyWhitelistMode',
          'storyAllowedContacts', 'selfChatCopilotEnabled', 'selfChatZeroTokenOnly',
          'contactPolicies', 'configUpdatedAt',
          'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(settingId) && isOwnerResource();
    }

    match /dictionary_entries/{entryId} {
      allow get: if isValidId(entryId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidDictionaryEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(entryId)
        && isValidDictionaryEntry(incoming())
        && isOwnerResource()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'term', 'meaning', 'district', 'language', 'replyStyleHint', 'updatedAt'
        ]);
      allow delete: if isValidId(entryId) && isOwnerResource();
    }

    match /chat_memories/{chatId} {
      allow get: if isValidId(chatId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(chatId)
        && isValidChatMemory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(chatId)
        && isValidChatMemory(incoming())
        && isOwnerResource()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'contactName', 'detectedDistrict', 'lastSummary', 'turns', 'updatedAt'
        ]);
      allow delete: if isValidId(chatId) && isOwnerResource();

      match /messages/{messageId} {
        allow get: if isValidId(chatId)
          && isValidId(messageId)
          && isOwnerResource()
          && (
            get(/databases/$(database)/documents/chat_memories/$(chatId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatArchiveMessage(incoming())
          && incoming().chatId == chatId
          && incoming().createdAt == request.time
          && (
            get(/databases/$(database)/documents/chat_memories/$(chatId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
        allow update: if false;
        allow delete: if isValidId(chatId) && isValidId(messageId) && isOwnerResource();
      }
    }

    match /inbox_notes/{noteId} {
      allow get: if isValidId(noteId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(noteId)
        && isValidInboxNote(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(noteId)
        && isValidInboxNote(incoming())
        && isOwnerResource()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'updatedAt']) ||
          isAdmin()
        );
      allow delete: if isValidId(noteId) && isOwnerResource();
    }

    match /bot_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && isValidBotSession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(sessionId)
        && isValidBotSession(incoming())
        && isOwnerResource()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'phoneNumber', 'credsData', 'updatedAt'
        ]);
      allow delete: if isValidId(sessionId) && isOwnerResource();
    }

    match /client_bots/{botId} {
      allow get: if isValidId(botId) && isOwnerResource();
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(botId)
        && isValidClientBot(incoming())
        && incoming().botId == botId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(botId)
        && isValidClientBot(incoming())
        && isOwnerResource()
        && incoming().botId == existing().botId
        && (incoming().ownerId == existing().ownerId || (existing().ownerId == 'server_admin' && isAdmin()))
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerId', 'clientName', 'phoneNumber', 'active', 'clientAccessKey',
          'moderateAllGroups', 'defaultModeration', 'groupRules',
          'savedReplyEnabled', 'savedReplyMessage', 'savedReplyCooldownMs',
          'keywordReplies', 'updatedAt'
        ]);
      allow delete: if isValidId(botId) && isOwnerResource();
    }
  }
}
