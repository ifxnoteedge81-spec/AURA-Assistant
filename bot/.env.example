# Google Gemini API Key (Required for .ai and .gemini commands)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Phone number with country code (digits only, no + or spaces)
# Recommended for headless deployments like Render so the pairing code prints automatically in logs.
# Example: 8801712345678
PAIRING_PHONE_NUMBER=""

# Optional: Owner WhatsApp number (digits only) allowed to toggle global bot commands remotely
OWNER_NUMBER=""

# Optional: Directory to store Baileys MultiFileAuthState session files
AUTH_DIR="./auth_info_baileys"

# Optional: HTTP healthcheck port (Render automatically injects PORT)
PORT=3000

# Optional: Auto-reply cooldown in milliseconds per private chat (default: 60000 = 1 minute)
AUTOREPLY_COOLDOWN_MS=60000
